# ========================================================
# Mini Task Manager - Master Environment Configuration
# Copy this file to .env before starting Docker Compose
# ========================================================

# PostgreSQL Credentials
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_db

# Backend Configuration
PORT=4000
DATABASE_URL=postgresql://task_user:task_password@postgres:5432/task_db?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL=60

# Frontend Configuration
# Note: This is accessed by your browser on your Mac, so it points to localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

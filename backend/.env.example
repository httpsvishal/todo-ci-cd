# Backend Server Configuration
PORT=4000

# PostgreSQL Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=<schema>
# For local Mac development without Docker: postgresql://postgres:postgres@localhost:5432/task_db?schema=public
# For Docker Compose: postgresql://task_user:task_password@postgres:5432/task_db?schema=public
DATABASE_URL=postgresql://task_user:task_password@postgres:5432/task_db?schema=public

# Redis Configuration
# For local Mac development without Docker: localhost
# For Docker Compose: redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL=60
